// The Mailflare Worker, configured from the repository root for the Deploy to
// Cloudflare button (which copies the whole monorepo, so the Worker can serve
// the web app). Mirrors apps/worker/wrangler.jsonc with paths from the root;
// `pnpm --filter @mailflare/worker check-types` checks they match.
{
    "$schema": "apps/worker/node_modules/wrangler/config-schema.json",
    "name": "enreap",
    "main": "apps/worker/src/index.ts",
    "compatibility_date": "2026-11-01",
    "compatibility_flags": ["nodejs_compat"],
    "keep_vars": true,
    "observability": { "enabled": true },
    "assets": {
        "directory": "apps/worker/app",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
    },
    "send_email": [{ "name": "EMAIL" }],
    // Daily housekeeping: expired links, sessions and counters.
    "triggers": { "crons": ["17 3 * * *"] },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "enreap_database",
            "migrations_dir": "apps/worker/migrations",
            "migrations_pattern": "apps/worker/migrations/*/migration.sql","database_id": "0a2f681e-01c9-4a38-8b67-1645286136c6",
        },
    ],
}
